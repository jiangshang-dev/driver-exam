<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.heima.modules.sys.dao.SysDictTypeDao">

    <select id="getDictTypeList" resultType="com.heima.modules.sys.entity.DictType">
        select id, dict_type from sys_dict_type order by dict_type, sort
    </select>

    <select id="getDictTypeByDictName" resultType="java.lang.Long">
        select id from sys_dict_type
        <where>
            <if test="dictCode != null and dictCode != ''">
                and dict_type = #{dictCode}
            </if>
        </where>
    </select>

</mapper>