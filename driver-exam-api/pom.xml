<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<groupId>com.heima</groupId>
		<artifactId>driver-exam</artifactId>
		<version>5.5.0</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>driver-exam-api</artifactId>
	<packaging>jar</packaging>
	<description>driver-exam-api</description>

	<dependencies>
		<dependency>
			<groupId>com.heima</groupId>
			<artifactId>driver-exam-common</artifactId>
			<version>5.5.0</version>
		</dependency>
		<dependency>
			<groupId>com.heima</groupId>
			<artifactId>driver-exam-dynamic-datasource</artifactId>
			<version>5.5.0</version>
		</dependency>
		<dependency>
			<groupId>com.heima</groupId>
			<artifactId>driver-exam-business</artifactId>
			<version>5.5.0</version>
		</dependency>
		<dependency>
			<groupId>com.heima</groupId>
			<artifactId>driver-exam-vod</artifactId>
			<version>5.5.0</version>
		</dependency>

		<dependency>
			<groupId>com.heima</groupId>
			<artifactId>driver-exam-ai</artifactId>
			<version>5.5.0</version>
		</dependency>
	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
